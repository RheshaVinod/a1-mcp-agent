# NVIDIA NIM (free tier) exposes an OpenAI-compatible endpoint.
# Get a key at https://build.nvidia.com -> "Get API Key".
OPENAI_API_KEY=nvapi-replace-me
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Tavily Search MCP. Free tier key from https://app.tavily.com
TAVILY_API_KEY=tvly-replace-me

# Deployment target
GCP_PROJECT_ID=ancient-booster-494014-a4
GCP_REGION=us-west1

# Runtime
MCP_CONFIG_PATH=/app/mcp_config.json
MCP_FILESYSTEM_ROOT=/app/workspace
